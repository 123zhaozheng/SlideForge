# OpenAI-compatible Image Generation API configuration for SlideForge
# Copy this file to .env and fill in your own credentials. NEVER commit .env!

OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Recommended models:
# - Official OpenAI: gpt-image-1
# - OpenAI-compatible relays: gpt-image-2.6 / gpt-image-1 / etc.
SLIDEFORGE_MODEL=gpt-image-1
SLIDEFORGE_QUALITY=high
SLIDEFORGE_SIZE=3840x2160
SLIDEFORGE_RESOLUTION=4k
SLIDEFORGE_ASPECT=16:9

# Set to "true" if you need requests to respect system HTTP_PROXY/HTTPS_PROXY
SLIDEFORGE_TRUST_ENV=false
